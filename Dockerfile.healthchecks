FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN useradd --create-home --uid 10001 worker \
    && mkdir -p /run/email-organiser \
    && chown worker:worker /run/email-organiser

COPY classifier_healthcheck.py heartbeat_settings.py ./

USER worker

# The Python process runs the checks continuously and logs each result.
CMD ["python", "classifier_healthcheck.py"]
